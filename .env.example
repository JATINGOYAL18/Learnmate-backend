# ==============================================================================
# LearnMate Backend - Environment Configuration Template
# Copy this file to '.env' and adjust the values for your environment.
# NEVER commit the actual '.env' file to source control.
# ==============================================================================

# Server Port (Cloud Run injects PORT automatically; defaults to 3000 locally)
PORT=3000

# Node Environment: 'development', 'production', or 'test'
NODE_ENV=development

# Allowed CORS Origin (Vite default is http://localhost:5173)
# In production, set this to your deployed frontend domain
CORS_ORIGIN=http://localhost:5173

# Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (defaults to gemini-2.5-flash if omitted)
GEMINI_MODEL=gemini-2.5-flash
