# ==============================================================================
# LearnMate Backend - Environment Configuration Template
# Copy this file to '.env' and adjust the values for your environment.
# NEVER commit the actual '.env' file to source control.
# ==============================================================================

# Server Port (Cloud Run injects PORT automatically; defaults to 3000 locally)
PORT=3000

# Node Environment: 'development', 'production', or 'test'
NODE_ENV=development

# Allowed CORS Origin (Vite default is http://localhost:5173)
# In production, set this to your deployed frontend domain
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Future Placeholder (For upcoming milestones - leave blank or unset for Milestone 1)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=
